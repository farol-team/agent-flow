#!/usr/bin/env bash
# parse-verdict — normalize a subagent verdict out of a Claude CLI JSON
# envelope. Mechanical half of flow-run Step 2.3 / 2.1a: the orchestrator
# (an LLM) should classify and decide, not regex-parse.
#
# Usage: parse-verdict acceptance <envelope.json>
#        parse-verdict critic     <envelope.json>
#
# stdout on exit 0: ONE normalized JSON object —
#   acceptance: {gaps, gaps_summary, minor, verdicts, learnings,
#                _fingerprints: {gaps: [fp|null,...], minor: [fp|null,...]},
#                _fps: {parsed, total},
#                _session_id, _cost_usd, _num_turns}
#   critic:     {verdict, findings, summary, learnings,
#                _session_id, _cost_usd, _num_turns}
# Exit 3: subagent said `BLOCKED: <reason>` → stdout {"blocked": "<reason>", ...meta}
# Exit 4: envelope/verdict unusable (crash path) → reason on stderr.
#
# Prose is tolerated around ONE verdict object. Ambiguous, incomplete or
# contradictory verdicts fail closed; no default may manufacture approval.
set -uo pipefail

die() { echo "parse-verdict: $1" >&2; exit 4; }

[ $# -eq 2 ] || die "usage: parse-verdict acceptance|critic <envelope.json>"
MODE="$1"; ENVELOPE="$2"
case "$MODE" in acceptance|critic) ;; *) die "unknown mode '$MODE'" ;; esac
command -v jq >/dev/null 2>&1 || die "jq is required"
[ -f "$ENVELOPE" ] || die "envelope not found: $ENVELOPE"

jq -s -e 'length == 1 and (.[0] | type == "object")' "$ENVELOPE" >/dev/null 2>&1 || die "envelope is not valid JSON: $ENVELOPE"
jq -e '.is_error != true and (.result | type == "string")' "$ENVELOPE" >/dev/null 2>&1 || die "envelope reports an error or result is not text"

META="$(jq '{_session_id: (.session_id // null), _cost_usd: (.total_cost_usd // 0), _num_turns: (.num_turns // null)}' "$ENVELOPE")"
RESULT="$(jq -r '.result // empty' "$ENVELOPE")"
[ -n "$RESULT" ] || die "envelope has empty result"

TRIMMED="$(printf '%s' "$RESULT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
case "$TRIMMED" in
  BLOCKED:*)
    # First line only — a multi-line remainder must not be smeared into
    # the card comment as "the reason".
    REASON="$(printf '%s' "$TRIMMED" | head -n1 | sed 's/^BLOCKED:[[:space:]]*//')"
    jq -cn --arg r "$REASON" --argjson meta "$META" '{blocked: $r} + $meta'
    exit 3
    ;;
esac

# Validate schema AND agreement between the machine-readable decisions.
# Required verdicts deliberately break the legacy two-key acceptance shape.
COMMON='(if has("learnings") then (.learnings | type == "array") else true end)'
if [ "$MODE" = "acceptance" ]; then
  REQUIRED='(.gaps | type == "array") and (.gaps | all(type == "string"))
    and (.gaps_summary | type == "string")
    and (if has("minor") then (.minor | type == "array") and (.minor | all(type == "string")) else true end)
    and (.verdicts | type == "object")
    and (.verdicts.spec | IN("pass", "fail"))
    and (.verdicts.quality | IN("approved", "rejected"))
    and (((.gaps | length) == 0) == (.verdicts.spec == "pass" and .verdicts.quality == "approved"))'
else
  REQUIRED='(.verdict | IN("approved", "rejected"))
    and (.findings | type == "array") and (.findings | all(type == "string"))
    and (if has("summary") then (.summary | type == "string") else true end)
    and (if .verdict == "approved" then (.findings | all(startswith("NIT:")))
         else (.findings | any(startswith("NIT:") | not)) end)'
fi

# Invalid JSON escapes are the one malformation seen in the field
# (agent-flow#13): a model quoting source code emits \` or \$ — template
# literals — and a substantively fine verdict fails every strict parser,
# which by contract would Block an approved card. Repair drops the
# backslash before any character that is not a legal JSON escape
# (legal: " \ / b f n r t u); the repaired line must still pass the
# required-keys check, so this never launders garbage into a verdict.
repair_escapes() {
  printf '%s' "$1" | sed -E 's/\\([^"\\/bfnrtu])/\1/g'
}

# Count candidates before validation: never fall back to an earlier approval
# when the final decision is malformed, or let an echoed example replace it.
VERDICT=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  case "$(printf '%s' "$line" | sed 's/^[[:space:]]*//')" in
    BLOCKED:*) die "blocked text mixed with a verdict" ;;
  esac
  case "$line" in *\{*) ;; *) continue ;; esac
  if ! printf '%s' "$line" | jq -s -e 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1; then
    line="$(repair_escapes "$line")"
  fi
  printf '%s' "$line" | jq -s -e 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1 \
    || die "malformed JSON candidate"
  [ -z "$VERDICT" ] || die "multiple verdict objects are ambiguous"
  VERDICT="$line"
done <<EOF
$RESULT
EOF
[ -n "$VERDICT" ] || die "no verdict object"
printf '%s' "$VERDICT" | jq -e "($COMMON) and ($REQUIRED)" >/dev/null 2>&1 \
  || die "invalid or contradictory $MODE verdict"

if [ "$MODE" = "critic" ]; then
  printf '%s' "$VERDICT" | jq -c --argjson meta "$META" \
    '{verdict, findings, summary: (.summary // ""), learnings: (.learnings // [])} + $meta'
  exit 0
fi

# Acceptance: fill contract defaults, extract fingerprints (first [...] group
# after the optional severity prefix; null when absent — fail-open, the entry
# still counts as a gap/minor, it just leaves history tracking).
printf '%s' "$VERDICT" | jq -c --argjson meta "$META" '
  # capture on a NON-MATCHING string emits an empty stream (not an error),
  # so wrap in an array and take first — otherwise unfingerprinted entries
  # are dropped and _fingerprints misaligns against gaps[]/minor[].
  def fp: [try (capture("^(?:[A-Z]+[[:space:]]+)?\\[(?<f>[^\\]]+)\\]") .f) catch null] | first // null;
  {gaps, gaps_summary,
   minor: (.minor // []),
   verdicts,
   review: (.review // null),
   learnings: (.learnings // [])}
  | . + {_fingerprints: {gaps: [.gaps[] | fp], minor: [.minor[] | fp]}}
  | . + {_fps: {parsed: ([.["_fingerprints"].gaps[], .["_fingerprints"].minor[]] | map(select(. != null)) | length),
                total:  ((.gaps | length) + (.minor | length))}}
  | . + $meta'
