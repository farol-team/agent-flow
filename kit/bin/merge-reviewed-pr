#!/usr/bin/env bash
# Usage: merge-reviewed-pr <pr-url> <worktree> <branch> <base> <reviewed-sha> <require-ci:true|false> <merge|squash|rebase>
# Call ONLY after confidence/risk and acceptance gates pass. Exit 0 means
# GitHub confirmed MERGED, not merely queued. Nonzero -> Review; preserve logs.
set -euo pipefail
[ "$#" -eq 7 ] || { echo 'merge-reviewed-pr: expected seven arguments' >&2; exit 1; }
PR="$1"; TREE="$2"; BRANCH="$3"; BASE="$4"; SHA="$5"; CI="$6"; STRATEGY="$7"
die() { echo "merge-reviewed-pr: $*" >&2; exit 1; }
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || die 'full reviewed SHA required'
case "$CI" in true|false) ;; *) die 'require-ci must be true or false' ;; esac
case "$STRATEGY" in merge|squash|rebase) ;; *) die 'unsupported merge strategy' ;; esac
VERIFY="$(cd "$(dirname "$0")" && pwd)/verify-pr-head"
"$VERIFY" "$PR" "$TREE" "$BRANCH" "$BASE" "$SHA" >/dev/null
if [ "$CI" = true ]; then
  # Include all reported checks: repos without required-check protection must
  # still supply evidence. Missing, skipped, pending, failed = no auto-merge.
  CHECKS="$(gh pr checks "$PR" --json name,bucket)" || die 'CI unavailable, pending or failed'
  printf '%s' "$CHECKS" | jq -e 'type == "array" and length > 0 and all(.bucket == "pass")' >/dev/null \
    || die 'CI must contain at least one check, all passing'
fi
# Check again after querying CI; GitHub enforces the same SHA at merge time.
"$VERIFY" "$PR" "$TREE" "$BRANCH" "$BASE" "$SHA" >/dev/null
# Keep the branch/worktree for inspection; cleanup belongs to /flow-clean.
gh pr merge "$PR" "--$STRATEGY" --match-head-commit "$SHA"
STATE="$(gh pr view "$PR" --json state)"
printf '%s' "$STATE" | jq -e '.state == "MERGED"' >/dev/null \
  || die 'merge not confirmed (possibly queued); do not mark Done'
