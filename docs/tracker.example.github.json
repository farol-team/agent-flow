{
  "tracker": {
    "provider": "github",
    "repo": "<owner>/<name>"
  },
  "states": {
    "icebox": "flow:icebox",
    "backlog": "flow:backlog",
    "triage": "flow:triage",
    "human_questions": "flow:human-questions",
    "plan_proposed": "flow:plan-proposed",
    "ready": "flow:ready",
    "in_progress": "flow:in-progress",
    "review": "flow:review",
    "blocked": "flow:blocked",
    "done": "flow:done"
  },
  "auto_merge_criteria": {
    "min_confidence": 7,
    "require_ci_green": true,
    "max_risk": "medium",
    "strategy": "merge"
  },
  "research": {
    "marker": "[research]",
    "doc_dir": "research",
    "target_repo": ".",
    "route": "review"
  },
  "epic": {
    "marker": "[epic]",
    "label_prefix": "epic:",
    "auto_refresh_checklist": true,
    "auto_create_min_cluster": 3
  },
  "labels": {
    "ai_generated": "<label id for the ai-generated label>"
  },
  "worker": {
    "max_turns": 100,
    "model": "",
    "resume_sessions": true
  },
  "acceptance": {
    "max_turns": 50,
    "model": ""
  },
  "tdd_gate": {
    "enabled": true,
    "min_size": "M",
    "min_risk": "medium",
    "max_spec_iterations": 2
  },
  "split_confirmation_phrase": "split confirmed",
  "card_prefix": "<PREFIX, e.g. ACME>",
  "branch_prefix": "trello/",
  "default_target": "app",
  "repo_label_prefix": "repo:",
  "targets": {
    "app": {
      "repo_root": ".",
      "worktree_root": ".gilb/worktrees",
      "worker_log_dir": ".gilb/worker-logs",
      "branch_prefix": "trello/",
      "toolchain": "<rust|rails|node|docs>",
      "test_cmd": "<e.g. bundle exec rspec <path> / cargo test -p <crate>>",
      "lint_cmd": "<e.g. bin/rubocop <path> / cargo clippy ...>"
    }
  },
  "project_context_docs": [
    "README.md"
  ],
  "session_log": ".gilb/session-log.md",
  "learnings": ".claude/learnings.jsonl",
  "comment_prefixes": {
    "meta": "[meta] ",
    "worker": "[worker] "
  }
}
